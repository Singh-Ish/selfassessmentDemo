# Environment variables for Self Assessment Portal
# Copy this file to .env and update the values

# Application settings
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# Database settings
# For local development (recommended)
MONGODB_URI=mongodb://localhost:27017/assessment
# For Docker development
# MONGODB_URI=mongodb://mongodb:27017/assessment
# For remote MongoDB Atlas (not recommended for local dev)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/assessment

# Email settings (optional - for email functionality)
MAIL_SERVER=your-mail-server.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=your-email@example.com

# Application URLs
APP_URL=http://127.0.0.1:5000